theme = catppuccin-mocha

font-family = JetBrainsMono Nerd Font Mono
font-size = 15
font-thicken = true
adjust-cell-height = 10%

background-opacity = 0.85
background-blur-radius = 20
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = transparent

cursor-style = bar
mouse-hide-while-typing = true
copy-on-select = clipboard

# Norwegian layout: left Option acts as Alt (word navigation, Zellij shortcuts).
# Right Option still types @ { } [ ] | \ $
macos-option-as-alt = left

# Ghostty's defaults turn these into ESC b / ESC f, which Zellij reads as Alt+b
# and Alt+f (toggle floating panes). Send real alt+arrows instead.
keybind = alt+left=unbind
keybind = alt+right=unbind
